# Homebrew formula template; the release workflow fills in @...@ and pushes it
# to the homebrew-tap repository.
class Agnts < Formula
  desc "Install and manage agnts on a Linux server"
  homepage "https://agnts.uz"
  version "@VERSION@"

  on_macos do
    on_arm do
      url "https://agnts.uz/cli/v@VERSION@/agnts-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_MAC_ARM@"
    end
    on_intel do
      url "https://agnts.uz/cli/v@VERSION@/agnts-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_MAC_X86@"
    end
  end

  on_linux do
    on_arm do
      url "https://agnts.uz/cli/v@VERSION@/agnts-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_ARM@"
    end
    on_intel do
      url "https://agnts.uz/cli/v@VERSION@/agnts-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_X86@"
    end
  end

  def install
    bin.install "agnts"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/agnts --version")
  end
end
