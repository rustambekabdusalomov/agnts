{
  "name": "agnts-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi generate && node -e \"require('fs').rmSync('dist',{force:true})\"",
    "generate": "nuxi generate && node -e \"require('fs').rmSync('dist',{force:true})\"",
    "preview": "nuxi preview",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "nuxi typecheck",
    "postinstall": "nuxi prepare"
  },
  "dependencies": {
    "@nuxtjs/i18n": "~9.5.6",
    "nuxt": "~3.21.11",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  },
  "overrides": {
    "@nuxt/schema": "~3.21.11"
  }
}
