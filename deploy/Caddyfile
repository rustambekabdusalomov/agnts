{
	email {$ACME_EMAIL}
}

{$AGNTS_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Google's sign-in button (accounts.google.com/gsi) on the sign-in page;
		# meetings' WebRTC signaling (wss://, /rtc) and video (blob:, recordings).
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss://{$AGNTS_DOMAIN} https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# Meetings: the call page uses the camera, the microphone and screen sharing.
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), autoplay=(self)"
		-Server
	}

	# agnts-link connectors (private networks) go to the gateway service.
	handle /link {
		reverse_proxy gateway:3130
	}
	# Meetings: LiveKit's signaling (the media goes to its own ports).
	handle /rtc* {
		reverse_proxy livekit:7880
	}
	# agnts serves the admin panel, /api, /healthz, /mcp and webhooks.
	# Server-Sent Events are flushed immediately by Caddy.
	handle {
		reverse_proxy agnts:8080
	}
}
