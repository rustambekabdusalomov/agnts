# Local development settings, used by `make dev-server`. Not secret.
# A fresh database since the Google sign-in and separate Admin accounts. The
# earlier one is kept: switch back by using the commented line instead.
AGNTS_DATABASE_URL=postgres://hiro:hiro@localhost:5442/agnts?sslmode=disable
# AGNTS_DATABASE_URL=postgres://hiro:hiro@localhost:5442/hiro?sslmode=disable
AGNTS_PUBLIC_URL=http://localhost:5173
AGNTS_ENC_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=
AGNTS_COOKIE_SECURE=false
AGNTS_LOG_FORMAT=text
AGNTS_LOG_LEVEL=debug
AGNTS_DATA_DIR=../.dev-data-agnts
# agnts-guard for the run containers; `make dev-guard` (part of dev-server) builds it.
AGNTS_GUARD_BIN=../.dev-data-agnts/agnts-guard
# AGNTS_DATA_DIR=../.dev-data  (with the earlier database)
AGNTS_GIT_AUTHOR_NAME="agnts dev"
AGNTS_GIT_AUTHOR_EMAIL=dev@localhost
# Sign-in: Google for Users (the website and the admin panel), a password
# for Admins only.
AGNTS_SIGNUP=open
AGNTS_PASSWORD_SIGNIN=admins
AGNTS_SITE_URL=http://localhost:3000
AGNTS_GOOGLE_CLIENT_ID=340542876762-6bqfc0a1s9eumku5qv7b14nvpu5qdvs1.apps.googleusercontent.com
# The mobile app's iOS OAuth client (comma-separated if more), so its Google
# ID tokens are accepted: see apps/mobile/ios/Flutter/Google.xcconfig.
AGNTS_GOOGLE_APP_CLIENT_IDS=340542876762-g90m3i4289m29mbkvbdgll9ns5m6vlai.apps.googleusercontent.com

# Private networks: the agnts-dev-gateway container (ports 3129/3130).
AGNTS_GATEWAY=localhost:3129
AGNTS_GATEWAY_SECRET=6c571a30b6b9213d127b90a0e306923f7b6ed93faaf8b17a403c30099321a4da
