# Copy to .env on the server and fill in. Never commit .env.

# Public hostname; DNS A/AAAA records must point at this server.
AGNTS_DOMAIN=agnts.example.com
ACME_EMAIL=you@example.com

# Images from the agnts registry; `agnts install` and `agnts upgrade` pin the
# tag to the CLI's version. Pulling needs `docker login registry.agnts.uz`
# with the install id and your access key (the CLI does this).
AGNTS_IMAGE=registry.agnts.uz/agnts:latest
AGNTS_RUNNER_IMAGE=registry.agnts.uz/agnts-runner:latest
# agnts-guard, the hooks inside every run, ships in the agnts image; set this
# only to use another build (Linux, the run containers' CPU).
# AGNTS_GUARD_BIN=/usr/local/bin/agnts-guard

# Long random value, e.g. `openssl rand -base64 32 | tr -d /+=`.
POSTGRES_PASSWORD=change-me

AGNTS_PUBLIC_URL=https://agnts.example.com
# 32 random bytes, base64. Generate with `docker run --rm $AGNTS_IMAGE keygen`.
# Losing it makes every stored secret (TOTP seed, tokens) unreadable: back it up
# somewhere other than this server.
AGNTS_ENC_KEY=
AGNTS_LOG_LEVEL=info

# Commits on agnts branches are authored as you.
AGNTS_GIT_AUTHOR_NAME=Your Name
AGNTS_GIT_AUTHOR_EMAIL=you@example.com
# Host docker group id: getent group docker | cut -d: -f3
DOCKER_GID=999
# The coding tools this server offers, the first being the default:
# muse (Meta's Muse Code), claude, codex. The hackathon build offers Muse only.
AGNTS_PROVIDERS=muse
# agnts's own Meta Model API key (LLM_...): runs with no connected Muse
# account, or on a person's free credits, use it and are paid with credits.
# Empty turns credits off.
AGNTS_MUSE_PLATFORM_KEY=
# The most all workspaces together may spend on that key in a calendar
# month, in dollars (0 = no cap). Free credits count against it too.
AGNTS_MUSE_GLOBAL_CAP_USD=200
# Price overrides, $ per million tokens input/cached/output, e.g.
# muse-spark-1.3=1.25/0.15/4.25;muse-wonder-1.0=4/0.2/20 (empty = list prices).
AGNTS_MUSE_PRICES=
# A fallback host for runs on credits: another provider serving Muse Spark
# Open (Baseten for the Meta hackathon). Runs move there while agnts's Meta
# account is out of allowance or credit, or always, as an Admin chooses
# (Admin → Dashboard → Muse provider). Empty key turns it off.
AGNTS_MUSE_FALLBACK_KEY=
AGNTS_MUSE_FALLBACK_URL=https://inference.baseten.co/v1
AGNTS_MUSE_FALLBACK_MODEL=meta-models/muse-spark-open-1026
# Credits a person may spend on the fallback a calendar month unless an
# Admin set their own limit (Admin → Users; 0 = no limit).
AGNTS_MUSE_FALLBACK_USER_LIMIT=500
# The most all runs together may ever spend on the fallback, in dollars,
# such as the host's credit (0 = no cap).
AGNTS_MUSE_FALLBACK_CAP_USD=90
# Models per stage, empty for the tool's defaults (muse:spark, muse:wonder),
# and how many tickets run at once.
AGNTS_MODEL_ANALYZE=
AGNTS_MODEL_CODE=
AGNTS_PARALLEL=1
# Run containers: default memory, the highest a repository may ask for, and
# the size above which a repository's package cache is emptied (0 = no limit).
AGNTS_RUN_MEMORY_MB=4096
AGNTS_RUN_MEMORY_MAX_MB=8192
AGNTS_CACHE_MAX_GB=5
# Shared volume the language toolchains (Go, Node, Python, Rust, Java, ...)
# are installed into, once per version.
AGNTS_TOOLCHAIN_VOLUME=agnts-toolchains
AGNTS_SESSION_TTL=720h
TZ=UTC

# Extra hosts run containers may reach, comma-separated (empty = built-in list).
AGNTS_EGRESS_ALLOW=
# Push notifications: path (inside the container) to a Firebase service account file.
AGNTS_FCM_CREDENTIALS=
# Prometheus metrics on a private port (not published by Caddy), e.g. :9090.
AGNTS_METRICS_ADDR=

# Private networks (Settings → Private networks): VPN configs and agnts-link
# connectors that reach a team's self-hosted GitLab, Jira or registry. Off
# while AGNTS_GATEWAY is empty. To turn on: set both, build the OpenVPN
# sidecar (docker compose --profile build build ovpn) and start the gateway
# (docker compose --profile private-network up -d).
AGNTS_GATEWAY=
# Shared by agnts, the egress proxy and the gateway: openssl rand -hex 32
AGNTS_GATEWAY_SECRET=
# Where agnts-link connects; default AGNTS_PUBLIC_URL + /link.
# AGNTS_LINK_URL=https://api.example.com/link
# How many private networks a workspace may keep (default 5), and how many
# OpenVPN networks the server runs a sidecar container for (default 50).
# AGNTS_PRIVATE_NETWORKS_MAX=5
# AGNTS_OVPN_MAX=50

# Meetings (video calls, docker compose --profile meetings up -d). Off while
# AGNTS_LIVEKIT_URL is empty. LiveKit's API key and secret (any name, and a
# secret of at least 32 characters: openssl rand -hex 32) sign the tokens
# browsers join with and LiveKit's webhooks. Open 7881/tcp, 7882/udp and
# 3478/udp in the firewall; signaling goes through Caddy at /rtc.
AGNTS_LIVEKIT_URL=
# AGNTS_LIVEKIT_URL=wss://agnts.example.com
AGNTS_LIVEKIT_API_KEY=
AGNTS_LIVEKIT_API_SECRET=
# Recordings and notes need Egress (part of the meetings profile); notes
# also need ffmpeg in the runner image (rebuild it once) and Muse.
AGNTS_LIVEKIT_EGRESS=false
# Video recordings at once on this server (each takes 2-4 CPUs), and the
# CPUs and memory Egress may use.
# AGNTS_MEET_MAX_RECORDINGS=2
# AGNTS_EGRESS_CPUS=3
# AGNTS_EGRESS_MEMORY=3g
# Notes from everyone's audio together (mixed) or each microphone apart
# (per-speaker: names who spoke; test it on your server first).
# AGNTS_MEET_NOTES_AUDIO=mixed
