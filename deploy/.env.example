# Copy to .env on the server and fill in. Never commit .env.

# Public hostname; DNS A/AAAA records must point at this server.
HIRO_DOMAIN=hiro.example.com
ACME_EMAIL=you@example.com

# Images built by CI (ghcr.io/<github-owner>/hiro and .../hiro-runner).
HIRO_IMAGE=ghcr.io/OWNER/hiro:latest
HIRO_RUNNER_IMAGE=ghcr.io/OWNER/hiro-runner:latest

# Long random value, e.g. `openssl rand -base64 32 | tr -d /+=`.
POSTGRES_PASSWORD=change-me

HIRO_PUBLIC_URL=https://hiro.example.com
# 32 random bytes, base64. Generate with `docker run --rm $HIRO_IMAGE keygen`.
# Losing it makes every stored secret (TOTP seed, tokens) unreadable: back it up
# somewhere other than this server.
HIRO_ENC_KEY=
HIRO_LOG_LEVEL=info

# Commits on hiro branches are authored as you.
HIRO_GIT_AUTHOR_NAME=Your Name
HIRO_GIT_AUTHOR_EMAIL=you@example.com
# Host docker group id: getent group docker | cut -d: -f3
DOCKER_GID=999
# Models per stage (aliases or full ids) and how many tickets run at once.
HIRO_MODEL_ANALYZE=opus
HIRO_MODEL_CODE=opus
HIRO_PARALLEL=1
HIRO_SESSION_TTL=720h
TZ=UTC

# Extra hosts run containers may reach, comma-separated (empty = built-in list).
HIRO_EGRESS_ALLOW=
# Push notifications: path (inside the container) to a Firebase service account file.
HIRO_FCM_CREDENTIALS=
# Prometheus metrics on a private port (not published by Caddy), e.g. :9090.
HIRO_METRICS_ADDR=
