# Copy to .env on the server and fill in. Never commit .env.

# Public hostname; DNS A/AAAA records must point at this server.
AGNTS_DOMAIN=agnts.example.com
ACME_EMAIL=you@example.com

# Images from the agnts registry; `agnts install` and `agnts upgrade` pin the
# tag to the CLI's version. Pulling needs `docker login registry.agnts.uz`
# with the install id and your access key (the CLI does this).
AGNTS_IMAGE=registry.agnts.uz/agnts:latest
AGNTS_RUNNER_IMAGE=registry.agnts.uz/agnts-runner:latest
# agnts-guard, the hooks inside every run, ships in the agnts image; set this
# only to use another build (Linux, the run containers' CPU).
# AGNTS_GUARD_BIN=/usr/local/bin/agnts-guard

# Long random value, e.g. `openssl rand -base64 32 | tr -d /+=`.
POSTGRES_PASSWORD=change-me

AGNTS_PUBLIC_URL=https://agnts.example.com
# 32 random bytes, base64. Generate with `docker run --rm $AGNTS_IMAGE keygen`.
# Losing it makes every stored secret (TOTP seed, tokens) unreadable: back it up
# somewhere other than this server.
AGNTS_ENC_KEY=
AGNTS_LOG_LEVEL=info

# Commits on agnts branches are authored as you.
AGNTS_GIT_AUTHOR_NAME=Your Name
AGNTS_GIT_AUTHOR_EMAIL=you@example.com
# Host docker group id: getent group docker | cut -d: -f3
DOCKER_GID=999
# Models per stage (aliases or full ids) and how many tickets run at once.
AGNTS_MODEL_ANALYZE=opus
AGNTS_MODEL_CODE=opus
AGNTS_PARALLEL=1
# Run containers: default memory, the highest a repository may ask for, and
# the size above which a repository's package cache is emptied (0 = no limit).
AGNTS_RUN_MEMORY_MB=4096
AGNTS_RUN_MEMORY_MAX_MB=8192
AGNTS_CACHE_MAX_GB=5
# Shared volume the language toolchains (Go, Node, Python, Rust, Java, ...)
# are installed into, once per version.
AGNTS_TOOLCHAIN_VOLUME=agnts-toolchains
AGNTS_SESSION_TTL=720h
TZ=UTC

# Extra hosts run containers may reach, comma-separated (empty = built-in list).
AGNTS_EGRESS_ALLOW=
# Push notifications: path (inside the container) to a Firebase service account file.
AGNTS_FCM_CREDENTIALS=
# Prometheus metrics on a private port (not published by Caddy), e.g. :9090.
AGNTS_METRICS_ADDR=

# Private networks (Settings → Private networks): VPN configs and agnts-link
# connectors that reach a team's self-hosted GitLab, Jira or registry. Off
# while AGNTS_GATEWAY is empty. To turn on: set both, build the OpenVPN
# sidecar (docker compose --profile build build ovpn) and start the gateway
# (docker compose --profile private-network up -d).
AGNTS_GATEWAY=
# Shared by agnts, the egress proxy and the gateway: openssl rand -hex 32
AGNTS_GATEWAY_SECRET=
# Where agnts-link connects; default AGNTS_PUBLIC_URL + /link.
# AGNTS_LINK_URL=https://api.example.com/link
# How many private networks a workspace may keep (default 5), and how many
# OpenVPN networks the server runs a sidecar container for (default 50).
# AGNTS_PRIVATE_NETWORKS_MAX=5
# AGNTS_OVPN_MAX=50
