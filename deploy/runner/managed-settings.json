{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash",
      "TodoWrite",
      "Task",
      "Skill"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "WebFetch"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedHooksOnly": true,
  "enableAllProjectMcpServers": false,
  "allowedMcpServers": [],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "g=/home/agent/.agnts/bin/agnts-guard; [ -x \"$g\" ] || exit 0; exec \"$g\" pre",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "g=/home/agent/.agnts/bin/agnts-guard; [ -x \"$g\" ] || exit 0; exec \"$g\" post",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "g=/home/agent/.agnts/bin/agnts-guard; [ -x \"$g\" ] || exit 0; exec \"$g\" stop",
            "timeout": 1800
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "g=/home/agent/.agnts/bin/agnts-guard; [ -x \"$g\" ] || exit 0; exec \"$g\" session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
