{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash",
      "TodoWrite",
      "Task"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "WebFetch"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
