# The hosted product on three domains (CADDYFILE=./Caddyfile.cloud in .env):
#   AGNTS_SITE_DOMAIN  the public website, static files in ./website
#   AGNTS_DOMAIN       the admin panel, with its /api on the same origin
#   AGNTS_API_DOMAIN   the API for everything that is not a browser: the
#                      mobile app, the CLI, webhooks and MCP clients
# The admin panel and the API are one agnts server: the panel calls /api on
# its own origin, so its session cookie stays host-only and SameSite=Strict.

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$AGNTS_SITE_DOMAIN} {
	import security
	encode zstd gzip
	header {
		X-Frame-Options "DENY"
		# Google's sign-in button, and its form post to the admin panel's /auth/google, and the "Request a connector" form's call to /site.
		# Nuxt's hydration data is an inline script, hence 'unsafe-inline' for scripts.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://accounts.google.com/gsi/ https://{$AGNTS_DOMAIN}; frame-src https://accounts.google.com/gsi/; frame-ancestors 'none'; base-uri 'self'; form-action https://{$AGNTS_DOMAIN}"
	}
	root * /srv/website
	# Hashed build assets never change.
	@assets path /_nuxt/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} {path}/index.html
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

www.{$AGNTS_SITE_DOMAIN} {
	redir https://{$AGNTS_SITE_DOMAIN}{uri} permanent
}

{$AGNTS_DOMAIN} {
	import security
	encode zstd gzip
	header {
		X-Frame-Options "DENY"
		# Google's sign-in button (accounts.google.com/gsi) on the sign-in page.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
	reverse_proxy agnts:8080
}

{$AGNTS_API_DOMAIN} {
	import security
	encode zstd gzip
	# The API, webhooks and MCP; anything else (the panel's pages) lives on the panel's domain.
	@api path /api/* /webhooks/* /mcp /mcp/* /oauth/* /.well-known/* /auth/*
	handle @api {
		reverse_proxy agnts:8080
	}
	handle {
		redir https://{$AGNTS_DOMAIN}{uri}
	}
}

# Pitch Day 3.0 demo site: static files in ./pitch-day, with /demo at /demo/.
pitch-day.agnts.uz {
	import security
	encode zstd gzip
	header {
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; frame-ancestors 'none'; base-uri 'self'"
	}
	root * /srv/pitch-day
	try_files {path} {path}/index.html
	file_server
}
